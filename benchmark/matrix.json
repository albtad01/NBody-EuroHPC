{
  "schema_version": 1,
  "description": "Primary validated N-scaling matrix for NBody-EuroHPC",
  "defaults": {
    "repetitions": 5,
    "warmup_iterations": 3,
    "scheme": "galaxy",
    "dt": 3600,
    "gpu_sampling_ms": 200
  },
  "n_sweep": [1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000],
  "primary": {
    "cpu+naive": {
      "group": "cpu",
      "n_values": [1000, 2000, 5000, 10000, 20000],
      "iterations": {"1000": 200, "2000": 100, "5000": 50, "10000": 20, "20000": 10},
      "timeout_seconds": 300,
      "cpu_count": 1,
      "gpu_count": 0
    },
    "cpu+omp": {
      "group": "cpu",
      "n_values": [1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000],
      "iterations": {"1000": 500, "2000": 500, "5000": 200, "10000": 100, "20000": 50, "50000": 20, "100000": 10, "200000": 5},
      "timeout_seconds": 300,
      "cpu_count": "SLURM_CPUS_PER_TASK",
      "gpu_count": 0
    },
    "gpu+tile+full": {
      "group": "gpu",
      "n_values": [1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000],
      "iterations": {"1000": 1000, "2000": 1000, "5000": 500, "10000": 200, "20000": 100, "50000": 50, "100000": 20, "200000": 10},
      "timeout_seconds": 300,
      "cpu_count": 8,
      "gpu_count": 1
    },
    "gpu+multinode": {
      "group": "gpu",
      "n_values": [1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000],
      "iterations": {"1000": 1000, "2000": 1000, "5000": 500, "10000": 200, "20000": 100, "50000": 50, "100000": 20, "200000": 10},
      "timeout_seconds": 300,
      "cpu_count": 32,
      "gpu_count": 4
    }
  },
  "exploratory_not_in_primary_matrix": [
    "cpu+optim",
    "cpu+simd",
    "gpu+tile",
    "gpu+tile+full200k"
  ]
}
